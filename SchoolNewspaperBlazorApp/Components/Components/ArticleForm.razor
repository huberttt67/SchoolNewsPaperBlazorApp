@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service

@inject IArticleService articleService
@inject IFileService fileService
@inject IJSRuntime JS

<div class="af">
    <aside class="af-rail" aria-label="Sekcje artykułu">
        <div class="af-rail__head">
            <span class="af-rail__eyebrow">
                @(EditingArticle is null ? "NOWY ARTYKUŁ" : "EDYCJA ARTYKUŁU")
            </span>
            <strong class="af-rail__title">
                @(string.IsNullOrWhiteSpace(title) ? "Bez tytułu" : title)
            </strong>
        </div>

        <nav class="af-rail__nav">
            <button type="button"
                    class="af-tab @(activeTab == FormTab.Info ? "is-active" : "")"
                    @onclick="() => activeTab = FormTab.Info">
                <span class="af-tab__icon">✎</span>
                <span class="af-tab__text">
                    <strong>Informacje</strong>
                    <small>Tytuł, treść, autor, okładka</small>
                </span>
            </button>

            <button type="button"
                    class="af-tab @(activeTab == FormTab.Gallery ? "is-active" : "")"
                    @onclick="() => activeTab = FormTab.Gallery">
                <span class="af-tab__icon">▦</span>
                <span class="af-tab__text">
                    <strong>Galeria</strong>
                    <small>Dodatkowe zdjęcia artykułu</small>
                </span>
                @if (GalleryTotal > 0)
                {
                    <span class="af-tab__badge">@GalleryTotal</span>
                }
            </button>

            <button type="button"
                    class="af-tab @(activeTab == FormTab.Preview ? "is-active" : "")"
                    @onclick="() => activeTab = FormTab.Preview">
                <span class="af-tab__icon">◉</span>
                <span class="af-tab__text">
                    <strong>Podgląd</strong>
                    <small>Artykuł przed publikacją</small>
                </span>
            </button>
        </nav>

        <ul class="af-checklist">
            <li class="is-done">
                <span class="af-checklist__dot"></span>
                Rodzaj: @articleType.Label()
            </li>
            <li class="@(string.IsNullOrWhiteSpace(title) ? "" : "is-done")">
                <span class="af-checklist__dot"></span>Tytuł
            </li>
            <li class="@(string.IsNullOrWhiteSpace(text) ? "" : "is-done")">
                <span class="af-checklist__dot"></span>Treść
            </li>
            <li class="@(string.IsNullOrWhiteSpace(author) ? "" : "is-done")">
                <span class="af-checklist__dot"></span>Autor
            </li>
            <li class="@(HasCover ? "is-done" : "")">
                <span class="af-checklist__dot"></span>Zdjęcie główne
            </li>
        </ul>
    </aside>

    <form class="af-main"
          @onsubmit="SaveArticleAsync"
          @onsubmit:preventDefault>

        <section class="af-pane @(activeTab == FormTab.Info ? "is-active" : "")">
            <header class="af-pane__header">
                <span class="af-pane__eyebrow">PODSTAWOWE DANE</span>
                <h2>Informacje o artykule</h2>
                <p>Uzupełnij tytuł, treść i autora oraz wybierz zdjęcie główne.</p>
            </header>

            <div class="af-info-grid">
                <div class="af-fields">
                    <div class="af-field">
                        <span class="form-label">Rodzaj artykułu</span>
                        <div class="af-types" role="radiogroup" aria-label="Rodzaj artykułu">
                            @foreach (var option in Enum.GetValues<ArticleType>())
                            {
                                <button type="button"
                                        role="radio"
                                        aria-checked="@(articleType == option ? "true" : "false")"
                                        class="af-type af-type--@option.Slug() @(articleType == option ? "is-active" : "")"
                                        @onclick="() => articleType = option">
                                    <strong>@option.Label()</strong>
                                    <small>@option.Description()</small>
                                </button>
                            }
                        </div>
                    </div>

                    <div class="af-field">
                        <label class="form-label" for="articleTitle">Tytuł</label>
                        <input id="articleTitle"
                               @bind="title"
                               @bind:event="oninput"
                               class="form-control"
                               placeholder="Wpisz tytuł..."
                               maxlength="200" />
                    </div>

                    <div class="af-field">
                        <label class="form-label" for="articleText">Treść artykułu</label>

                        <div class="af-inline-tools">
                            <label class="af-button af-button--secondary af-inline-tools__button">
                                ＋ Wstaw zdjęcie w treści
                                <InputFile OnChange="ChooseInlinePhotoAsync"
                                           accept="image/*"
                                           disabled="@isSaving" />
                            </label>
                            <small>Ustaw kursor w wybranym miejscu. Maksymalny rozmiar zdjęcia: 5 MB.</small>
                        </div>

                        <textarea id="articleText"
                                  @bind="text"
                                  @bind:event="oninput"
                                  class="form-control"
                                  rows="12"
                                  placeholder="Napisz artykuł… Ustaw kursor w wybranym miejscu, aby wstawić zdjęcie."></textarea>

                        <small class="af-note">
                            Zdjęcie „do lewej” lub „do prawej” jest opływane tekstem. Ułożenie
                            zdjęć, które już są w tekście, zmienisz przyciskami poniżej.
                        </small>

                        <InlineImageAligner @bind-Text="text" />
                    </div>

                    <div class="af-field">
                        <label class="form-label" for="articleAuthor">Autor</label>
                        <input id="articleAuthor"
                               @bind="author"
                               @bind:event="oninput"
                               class="form-control"
                               placeholder="Imię i nazwisko"
                               maxlength="150" />
                    </div>

                    <div class="af-field">
                        <label class="form-label" for="articleTags">Tagi (oddzielone przecinkami)</label>
                        <input id="articleTags"
                               @bind="tags"
                               @bind:event="oninput"
                               class="form-control"
                               placeholder="Np. sport, konkurs, klasa 3TA"
                               maxlength="300" />
                    </div>

                    <div class="af-field">
                        <label class="form-label" style="display:flex;align-items:center;gap:10px;cursor:pointer;">
                            <input type="checkbox" @bind="isPinned" />
                            📌 Przypnij na górze strony głównej
                        </label>
                    </div>
                </div>

                <div class="af-cover">
                    <span class="af-cover__label">Zdjęcie główne</span>

                    <div class="af-cover__frame @(CoverSrc is null ? "is-empty" : "")">
                        @if (CoverSrc is not null)
                        {
                            <img src="@CoverSrc" alt="Zdjęcie główne artykułu" />
                        }
                        else
                        {
                            <div class="af-cover__placeholder">
                                <span>▣</span>
                                <p>Brak zdjęcia</p>
                            </div>
                        }
                    </div>

                    <p class="af-cover__hint">
                        Okładka widoczna na kafelku artykułu i na początku tekstu.
                        @if (EditingArticle is not null)
                        {
                            <span>Zostaw bez zmian, aby zachować obecne zdjęcie.</span>
                        }
                    </p>

                    <label class="af-button af-button--primary af-button--block">
                        @(CoverSrc is null ? "Wybierz zdjęcie główne" : "Zmień zdjęcie główne")
                        <InputFile OnChange="ChoosePhoto" accept="image/*" />
                    </label>
                </div>
            </div>
        </section>

        <section class="af-pane @(activeTab == FormTab.Preview ? "is-active" : "")">
            <header class="af-pane__header">
                <span class="af-pane__eyebrow">PODGLĄD PUBLIKACJI</span>
                <h2>@(string.IsNullOrWhiteSpace(title) ? "Tytuł artykułu" : title)</h2>
                <p>Tak będzie wyglądać artykuł po otwarciu na stronie.</p>
            </header>

            <InlineImageAligner @bind-Text="text" />

            <article class="af-preview-article">
                @if (CoverSrc is not null)
                {
                    <div class="af-preview-article__cover">
                        <img src="@CoverSrc" alt="Zdjęcie główne artykułu" />
                    </div>
                }

                <div class="af-preview-article__meta">
                    <span>@articleType.Label()</span>
                    <span>@(string.IsNullOrWhiteSpace(author) ? "Autor" : author)</span>
                </div>

                <h1 class="af-preview-article__title">
                    @(string.IsNullOrWhiteSpace(title) ? "Tytuł artykułu" : title)
                </h1>

                <div class="af-preview-article__body">
                    <ArticleBody Text="@text" />
                </div>
            </article>
        </section>

        <section class="af-pane @(activeTab == FormTab.Gallery ? "is-active" : "")">
            <header class="af-pane__header">
                <span class="af-pane__eyebrow">WIĘCEJ KADRÓW</span>
                <h2>Galeria zdjęć</h2>
                <p>Dodatkowe zdjęcia widoczne dopiero po otwarciu artykułu. Maksymalnie @MaxGalleryFiles zdjęć.</p>
            </header>

            <label class="af-dropzone">
                <span class="af-dropzone__icon">＋</span>
                <span class="af-dropzone__text">
                    <strong>Wybierz zdjęcia do galerii</strong>
                    <small>Możesz zaznaczyć kilka plików jednocześnie.</small>
                </span>
                <InputFile OnChange="ChooseGalleryPhotos" accept="image/*" multiple />
            </label>

            @if (galleryFiles.Count > 0)
            {
                <div class="af-block">
                    <div class="af-block__head">
                        <h3>Do dodania <span class="af-count">@galleryFiles.Count</span></h3>
                        <button type="button" class="af-link" @onclick="ClearSelectedGallery">
                            Wyczyść wybór
                        </button>
                    </div>

                    <div class="af-thumbs">
                        @foreach (var galleryFile in galleryFiles.ToList())
                        {
                            <figure class="af-thumb af-thumb--new" @key="galleryFile">
                                @if (thumbnails.TryGetValue(galleryFile, out var thumb))
                                {
                                    <img src="@thumb" alt="@galleryFile.Name" />
                                }
                                else
                                {
                                    <div class="af-thumb__fallback">▣</div>
                                }

                                <figcaption title="@galleryFile.Name">@galleryFile.Name</figcaption>

                                <button type="button"
                                        class="af-thumb__remove"
                                        aria-label="Usuń z wyboru"
                                        @onclick="() => RemoveSelectedGalleryFile(galleryFile)">
                                    ×
                                </button>
                            </figure>
                        }
                    </div>

                    <p class="af-note">
                        Zdjęcia zostaną zapisane po kliknięciu przycisku zapisu.
                    </p>
                </div>
            }

            @if (EditingArticle is not null)
            {
                <div class="af-block">
                    <div class="af-block__head">
                        <h3>W galerii artykułu <span class="af-count">@existingGallery.Count</span></h3>
                    </div>

                    @if (existingGallery.Count == 0)
                    {
                        <div class="af-empty">
                            <span>▦</span>
                            <p>Ten artykuł nie ma jeszcze zdjęć w galerii.</p>
                        </div>
                    }
                    else
                    {
                        <div class="af-thumbs">
                            @foreach (var image in existingGallery)
                            {
                                var url = GalleryUrl(image);

                                <figure class="af-thumb" @key="image">
                                    <a href="@url" target="_blank" rel="noopener noreferrer">
                                        <img src="@url" alt="Zdjęcie z galerii" loading="lazy" />
                                    </a>

                                    <button type="button"
                                            class="af-thumb__remove af-thumb__remove--danger"
                                            aria-label="Usuń zdjęcie z galerii"
                                            disabled="@isSaving"
                                            @onclick="() => DeleteExistingGalleryImageAsync(image)">
                                        🗑
                                    </button>
                                </figure>
                            }
                        </div>
                    }
                </div>
            }
            else if (galleryFiles.Count == 0)
            {
                <div class="af-empty">
                    <span>▦</span>
                    <p>Nie wybrano jeszcze zdjęć do galerii.</p>
                </div>
            }
        </section>

        <footer class="af-actions">
            <span class="af-actions__hint">
                @if (galleryFiles.Count > 0)
                {
                    <span>Do galerii czeka: @galleryFiles.Count zdjęć.</span>
                }
                else
                {
                    <span>Wszystkie zmiany zapiszą się po kliknięciu przycisku.</span>
                }
            </span>

            <button type="submit"
                    class="af-button af-button--primary af-button--save"
                    disabled="@isSaving">
                @(isSaving
                    ? "Zapisywanie..."
                    : EditingArticle is null
                        ? "Opublikuj artykuł"
                        : "Zapisz zmiany")
            </button>
        </footer>
    </form>
</div>

@code {
    private const int MaxGalleryFiles = 30;
    private const long MaxFileSize = 5 * 1024 * 1024;

    private enum FormTab { Info, Gallery, Preview }

    [Parameter]
    public Article? EditingArticle { get; set; }

    [Parameter]
    public EventCallback OnSaved { get; set; }

    private FormTab activeTab = FormTab.Info;

    private string title = "";
    private string text = "";

    // Nowe zdjęcie w treści jest wstawiane „do lewej”.
    // Ułożenie każdego zdjęcia zmienia się w liście pod polem tekstu.
    private const string inlineAlign = "left";

    private string author = "";
    private string tags = "";
    private bool isPinned;
    private ArticleType articleType = ArticleType.Nowosci;

    private string? previewImage;
    private string? currentCoverUrl;

    private IBrowserFile? file;
    private readonly List<IBrowserFile> galleryFiles = new();
    private readonly Dictionary<IBrowserFile, string> thumbnails = new();
    private List<string> existingGallery = new();

    private bool isSaving;
    private bool initialized;
    private int loadedArticleId;

    private string? CoverSrc => previewImage ?? currentCoverUrl;
    private bool HasCover => CoverSrc is not null;
    private int GalleryTotal => existingGallery.Count + galleryFiles.Count;

    private string GalleryUrl(string image) =>
        $"/Images/Gallery/{EditingArticle?.Id}/{Uri.EscapeDataString(image)}";

    private readonly Queue<(string Type, string Message)> pendingToasts = new();
    private string? _errorMessage;

    private string? errorMessage
    {
        get => _errorMessage;
        set
        {
            _errorMessage = value;

            if (!string.IsNullOrWhiteSpace(value))
                pendingToasts.Enqueue(("error", value));
        }
    }

    private void Notify(string message, string type = "success")
    {
        pendingToasts.Enqueue((type, message));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        while (pendingToasts.Count > 0)
        {
            var (type, message) = pendingToasts.Dequeue();

            try
            {
                await JS.InvokeVoidAsync("showToast", message, type);
            }
            catch (JSDisconnectedException)
            {
                pendingToasts.Clear();
            }
            catch (InvalidOperationException)
            {
                // JavaScript może być niedostępny podczas prerenderowania.
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var articleId = EditingArticle?.Id ?? 0;

        if (initialized && articleId == loadedArticleId)
            return;

        initialized = true;
        loadedArticleId = articleId;

        file = null;
        previewImage = null;
        currentCoverUrl = null;
        galleryFiles.Clear();
        thumbnails.Clear();
        existingGallery = new List<string>();
        activeTab = FormTab.Info;

        if (EditingArticle is not null)
        {
            title = EditingArticle.Title;
            text = EditingArticle.Text;
            author = EditingArticle.Author;
            articleType = EditingArticle.Type;
            tags = EditingArticle.Tags ?? "";
            isPinned = EditingArticle.IsPinned;

            try
            {
                var fileName = await fileService.GetFileNameByIdAsync(EditingArticle.FileId);

                if (!string.IsNullOrWhiteSpace(fileName))
                    currentCoverUrl = $"/Images/{fileName}";
            }
            catch
            {
                // Artykuł może nie mieć zdjęcia głównego.
            }

            await ReloadExistingGalleryAsync();
        }
        else
        {
            title = "";
            text = "";
            author = "";
            tags = "";
            isPinned = false;
            articleType = ArticleType.Nowosci;
        }
    }

    private async Task ReloadExistingGalleryAsync()
    {
        if (EditingArticle is null)
        {
            existingGallery = new List<string>();
            return;
        }

        try
        {
            existingGallery = await fileService.GetGalleryImagesAsync(EditingArticle.Id);
        }
        catch
        {
            existingGallery = new List<string>();
        }
    }

    private async Task ChoosePhoto(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        var chosen = e.File;

        if (!chosen.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "Zdjęcie główne musi być plikiem graficznym.";
            return;
        }

        if (chosen.Size <= 0 || chosen.Size > MaxFileSize)
        {
            errorMessage = "Zdjęcie jest zbyt duże (maksymalnie 5 MB).";
            return;
        }

        try
        {
            previewImage = await fileService.GetPreviewAsync(chosen);
            file = chosen;
        }
        catch
        {
            file = null;
            previewImage = null;
            errorMessage = "Nie udało się wczytać podglądu zdjęcia.";
        }
    }

    private async Task ChooseInlinePhotoAsync(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        var chosen = e.File;

        if (!chosen.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "Do treści można wstawiać wyłącznie pliki graficzne.";
            return;
        }

        if (chosen.Size <= 0 || chosen.Size > MaxFileSize)
        {
            errorMessage = "Zdjęcie w treści może mieć maksymalnie 5 MB.";
            return;
        }

        try
        {
            var imageId = await fileService.UploadImage(chosen);
            var fileName = await fileService.GetFileNameByIdAsync(imageId);

            if (string.IsNullOrWhiteSpace(fileName) ||
                !string.Equals(fileName, Path.GetFileName(fileName), StringComparison.Ordinal))
            {
                errorMessage = "Nie udało się ustalić nazwy zapisanego zdjęcia.";
                return;
            }

            var marker = $"\n\n[[IMG:{fileName}|{inlineAlign}]]\n\n";
            string? updatedText = null;

            try
            {
                updatedText = await JS.InvokeAsync<string?>(
                    "articleEditor.insertAtCursor", "articleText", marker);
            }
            catch (JSException)
            {
                // Gdy JavaScript nie działa, znacznik zostanie dodany na końcu.
            }
            catch (InvalidOperationException)
            {
                // Gdy JavaScript nie jest jeszcze dostępny.
            }

            if (updatedText is not null)
            {
                text = updatedText;
            }
            else
            {
                var safeMarker = $"[[IMG:{fileName}|{inlineAlign}]]";
                text = string.IsNullOrWhiteSpace(text)
                    ? safeMarker
                    : $"{text.TrimEnd()}\n\n{safeMarker}\n\n";
            }

            Notify("Zdjęcie wstawiono do treści artykułu.");
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Błąd wstawiania zdjęcia w treści: {ex}");
            errorMessage = "Nie udało się wstawić zdjęcia do treści artykułu.";
        }
    }

    private async Task ChooseGalleryPhotos(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        galleryFiles.Clear();
        thumbnails.Clear();

        if (e.FileCount > MaxGalleryFiles)
        {
            errorMessage = $"Do galerii można wybrać maksymalnie {MaxGalleryFiles} zdjęć naraz.";
            return;
        }

        var chosen = e.GetMultipleFiles(MaxGalleryFiles);

        if (chosen.Any(f => !f.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)))
        {
            errorMessage = "Galeria może zawierać wyłącznie zdjęcia.";
            return;
        }

        if (chosen.Any(f => f.Size <= 0 || f.Size > MaxFileSize))
        {
            errorMessage = "Każde zdjęcie w galerii może mieć maksymalnie 5 MB.";
            return;
        }

        galleryFiles.AddRange(chosen);

        foreach (var galleryFile in galleryFiles)
        {
            try
            {
                var resized = await galleryFile.RequestImageFileAsync("image/jpeg", 360, 270);

                using var stream = resized.OpenReadStream(1024 * 1024);
                using var memory = new MemoryStream();

                await stream.CopyToAsync(memory);

                thumbnails[galleryFile] =
                    $"data:image/jpeg;base64,{Convert.ToBase64String(memory.ToArray())}";
            }
            catch
            {
                // Brak miniatury nie blokuje dodania zdjęcia.
            }
        }
    }

    private void RemoveSelectedGalleryFile(IBrowserFile galleryFile)
    {
        galleryFiles.Remove(galleryFile);
        thumbnails.Remove(galleryFile);
    }

    private void ClearSelectedGallery()
    {
        galleryFiles.Clear();
        thumbnails.Clear();
    }

    private async Task DeleteExistingGalleryImageAsync(string image)
    {
        if (EditingArticle is null || isSaving)
            return;

        bool confirmed;

        try
        {
            confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                "Czy na pewno chcesz usunąć to zdjęcie z galerii?");
        }
        catch
        {
            errorMessage = "Nie udało się wyświetlić potwierdzenia usunięcia.";
            return;
        }

        if (!confirmed)
            return;

        try
        {
            await fileService.DeleteGalleryImageAsync(EditingArticle.Id, image);
            existingGallery.Remove(image);
            Notify("Zdjęcie zostało usunięte z galerii.");
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
        catch
        {
            errorMessage = "Nie udało się usunąć zdjęcia z galerii.";
        }
    }

    private async Task SaveArticleAsync()
    {
        if (isSaving)
            return;

        errorMessage = null;

        if (string.IsNullOrWhiteSpace(title) ||
            string.IsNullOrWhiteSpace(text) ||
            string.IsNullOrWhiteSpace(author))
        {
            activeTab = FormTab.Info;
            errorMessage = "Uzupełnij tytuł, treść i autora.";
            return;
        }

        if (EditingArticle is null && file is null)
        {
            activeTab = FormTab.Info;
            errorMessage = "Dodaj zdjęcie, aby opublikować artykuł.";
            return;
        }

        isSaving = true;

        try
        {
            int imageId = 0;

            if (file is not null)
                imageId = await fileService.UploadImage(file);

            if (EditingArticle is null)
            {
                var newArticleId = await articleService.AddArticleAsync(
                    title.Trim(),
                    text.Trim(),
                    author.Trim(),
                    imageId,
                    articleType,
                    tags,
                    isPinned);

                foreach (var galleryFile in galleryFiles)
                    await fileService.UploadGalleryImageAsync(newArticleId, galleryFile);
            }
            else
            {
                await articleService.UpdateArticleAsync(
                    EditingArticle.Id,
                    title.Trim(),
                    text.Trim(),
                    author.Trim(),
                    imageId,
                    articleType,
                    tags,
                    isPinned);

                foreach (var galleryFile in galleryFiles)
                    await fileService.UploadGalleryImageAsync(EditingArticle.Id, galleryFile);
            }

            await OnSaved.InvokeAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Błąd zapisu artykułu: {ex}");
            errorMessage = "Nie udało się zapisać artykułu. Sprawdź usługę artykułów i połączenie z bazą danych.";
        }
        finally
        {
            isSaving = false;
        }
    }
}
