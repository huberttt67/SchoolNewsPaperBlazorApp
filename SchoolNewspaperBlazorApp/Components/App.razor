
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @((MarkupString)ThemeScript)
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="SchoolNewspaperBlazorApp.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="article-editor.js"></script>
    <script src="_framework/blazor.web.js"></script>
    @((MarkupString)ToastScript)
    @((MarkupString)ProgressScript)
</body>

</html>

@code {
    // Motyw jasny/ciemny: ustawiany jeszcze przed narysowaniem strony (bez
    // „mignięcia”), zapamiętywany w przeglądarce, domyślnie jasny.
    private const string ThemeScript = @"<script>
(function () {
    var KEY = 'eti-theme';
    var root = document.documentElement;
    var current = null;

    try { current = localStorage.getItem(KEY); } catch (e) { }

    if (current !== 'dark' && current !== 'light') {
        current = 'light';
    }

    function apply(theme) {
        current = theme;
        root.setAttribute('data-theme', theme);
    }

    apply(current);

    // Blazor przy nawigacji potrafi odtworzyć atrybuty – pilnujemy motywu.
    new MutationObserver(function () {
        if (root.getAttribute('data-theme') !== current) {
            root.setAttribute('data-theme', current);
        }
    }).observe(root, { attributes: true, attributeFilter: ['data-theme'] });

    document.addEventListener('click', function (event) {
        var button = event.target && event.target.closest
            ? event.target.closest('[data-theme-toggle]') : null;

        if (!button) { return; }

        var next = current === 'dark' ? 'light' : 'dark';
        apply(next);

        try { localStorage.setItem(KEY, next); } catch (e) { }
    });
})();
</script>";

    // Pasek postępu czytania na stronie artykułu.
    private const string ProgressScript = @"<script>
(function () {
    function update() {
        var bar = document.getElementById('ap-progress-bar');
        if (!bar) { return; }

        var doc = document.documentElement;
        var max = doc.scrollHeight - doc.clientHeight;
        var percent = max > 0 ? (window.scrollY / max) * 100 : 0;

        bar.style.width = Math.min(100, Math.max(0, percent)) + '%';
    }

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    document.addEventListener('DOMContentLoaded', update);

    if (window.Blazor && window.Blazor.addEventListener) {
        window.Blazor.addEventListener('enhancednavigationend', update);
    }
})();
</script>";

    private const string ToastScript = @"<script>
(function () {
    if (window.__toastInit) { return; }
    window.__toastInit = true;

    var ICONS = { success: '✓', error: '!', warning: '!', info: 'i' };
    var MAX_VISIBLE = 3;

    function getContainer() {
        var c = document.getElementById('eti-toast-container');
        if (!c) {
            c = document.createElement('div');
            c.id = 'eti-toast-container';
            c.className = 'eti-toast-container';
            c.setAttribute('data-permanent', '');
            c.setAttribute('aria-live', 'polite');
            document.body.appendChild(c);
        }
        return c;
    }

    var visibleCount = 0;
    var waiting = [];

    function displayToast(item) {
        var message = item.message;
        var type = item.type;
        var duration = item.duration;
        var container = getContainer();

        var toast = document.createElement('div');
        toast.className = 'eti-toast eti-toast--' + type;
        toast.setAttribute('role', type === 'error' ? 'alert' : 'status');

        var icon = document.createElement('span');
        icon.className = 'eti-toast__icon';
        icon.textContent = ICONS[type];

        var text = document.createElement('span');
        text.className = 'eti-toast__text';
        text.textContent = message;

        var close = document.createElement('button');
        close.type = 'button';
        close.className = 'eti-toast__close';
        close.setAttribute('aria-label', 'Zamknij powiadomienie');
        close.textContent = '×';

        var bar = document.createElement('span');
        bar.className = 'eti-toast__bar';
        bar.style.animationDuration = duration + 'ms';

        toast.appendChild(icon);
        toast.appendChild(text);
        toast.appendChild(close);
        toast.appendChild(bar);
        container.appendChild(toast);

        visibleCount++;

        var timer = null;
        var closing = false;

        function remove() {
            if (closing) { return; }
            closing = true;

            if (timer) { clearTimeout(timer); timer = null; }

            toast.classList.add('eti-toast--hide');

            setTimeout(function () {
                if (toast.parentNode) {
                    toast.parentNode.removeChild(toast);
                }

                visibleCount--;
                showNext();
            }, 300);
        }

        close.addEventListener('click', remove);
        timer = setTimeout(remove, duration);
    }

    function showNext() {
        while (visibleCount < MAX_VISIBLE && waiting.length > 0) {
            displayToast(waiting.shift());
        }
    }

    window.showToast = function (message, type, duration) {
        if (!message) { return; }

        type = ICONS[type] ? type : 'info';
        duration = duration || (type === 'error' ? 5500 : 3800);

        waiting.push({
            message: message,
            type: type,
            duration: duration
        });

        showNext();
    };

    var TOAST_MESSAGES = {
        login: { text: 'Zalogowano pomyślnie.', type: 'success' },
        logout: { text: 'Wylogowano pomyślnie.', type: 'info' }
    };

    function handleQuery() {
        var params = new URLSearchParams(window.location.search);
        var key = params.get('toast');
        var hasError = params.has('error');

        if (!key && !hasError) { return; }

        if (key === 'locked') {
            var min = parseInt(params.get('min'), 10) || 5;
            window.showToast(
                'Zbyt wiele błędnych prób logowania. Spróbuj ponownie za ' + min + ' min.',
                'error',
                7000
            );
        } else if (hasError) {
            window.showToast(
                'Niepoprawny email lub hasło.',
                'error'
            );
        } else if (TOAST_MESSAGES[key]) {
            window.showToast(
                TOAST_MESSAGES[key].text,
                TOAST_MESSAGES[key].type
            );
        }

        params.delete('toast');
        params.delete('error');
        params.delete('min');

        var qs = params.toString();
        var url = window.location.pathname +
            (qs ? '?' + qs : '') +
            window.location.hash;

        window.history.replaceState(
            window.history.state,
            '',
            url
        );
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', handleQuery);
    } else {
        handleQuery();
    }

    if (window.Blazor && window.Blazor.addEventListener) {
        window.Blazor.addEventListener(
            'enhancednavigationend',
            handleQuery
        );
    }
})();
</script>";
}
