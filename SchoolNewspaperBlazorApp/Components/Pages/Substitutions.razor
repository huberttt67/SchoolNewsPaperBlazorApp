    private async Task RemoveTeacherAsync(Teacher teacher)
    {
        errorMessage = null;
        successMessage = null;

        await RefreshPermissionsAsync();

        if (!canDelete)
        {
            errorMessage = "Nie masz uprawnień do usuwania nauczycieli.";
            return;
        }

        bool confirmed;

        try
        {
            confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                $"Usunąć nauczyciela „{teacher.FullName}” z aktywnej listy?");
        }
        catch
        {
            errorMessage = "Nie udało się wyświetlić potwierdzenia.";
            return;
        }

        if (!confirmed)
        {
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var tracked = await db.Teachers.FirstOrDefaultAsync(
                t => t.Id == teacher.Id && !t.IsDeleted);

            if (tracked is null)
            {
                errorMessage = "Nie znaleziono nauczyciela.";
                return;
            }

            // Usunięcie logiczne — rekord pozostaje w bazie.
            tracked.IsDeleted = true;

            await db.SaveChangesAsync();

            if (editingTeacherId == teacher.Id)
            {
                CancelTeacherEdit();
            }

            await LoadDataAsync();

            successMessage = "Nauczyciel został usunięty z aktywnej listy.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Nie udało się usunąć nauczyciela.");
            errorMessage = "Nie udało się usunąć nauczyciela. Może być przypisany do zastępstwa.";
        }
    }

