    private async Task SaveSubstituteAsync()
    {
        errorMessage = null;
        successMessage = null;

        await RefreshPermissionsAsync();

        if (editingSubstituteId.HasValue ? !canEdit : !canCreate)
        {
            errorMessage = editingSubstituteId.HasValue
                ? "Nie masz uprawnień do edytowania zastępstw."
                : "Nie masz uprawnień do dodawania zastępstw.";
            return;
        }

        if (form.LessonNumber is < 1 or > 8)
        {
            errorMessage = "Numer lekcji musi być od 1 do 8.";
            return;
        }

        if (string.IsNullOrWhiteSpace(form.ClassName) ||
            !classes.Contains(form.ClassName))
        {
            errorMessage = "Wybierz klasę z listy.";
            return;
        }

        if (form.TeacherId <= 0 ||
            teachers.All(t => t.Id != form.TeacherId))
        {
            errorMessage = "Wybierz nauczyciela zastępującego.";
            return;
        }

        if (form.OriginalTeacherId is null ||
            teachers.All(t => t.Id != form.OriginalTeacherId.Value))
        {
            errorMessage = "Wybierz nauczyciela, za którego jest zastępstwo.";
            return;
        }

        if (form.TeacherId == form.OriginalTeacherId.Value)
        {
            errorMessage = "Wybierz dwóch różnych nauczycieli.";
            return;
        }

        if (form.RoomId is not null &&
            rooms.All(r => r.Id != form.RoomId.Value))
        {
            errorMessage = "Wybrana sala nie istnieje na liście.";
            return;
        }

        if (!TimeSpan.TryParse(startTime, out var start) ||
            !TimeSpan.TryParse(endTime, out var end) ||
            end <= start)
        {
            errorMessage = "Godzina zakończenia musi być późniejsza niż rozpoczęcia.";
            return;
        }

        isSaving = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // Sprawdzamy duplikat przed dodaniem lub aktualizacją.
            // Duplikat oznacza zastępstwo dla tej samej klasy,
            // tego samego dnia i tej samej lekcji.
            var duplicateExists = await db.Substitutes.AnyAsync(s =>
                !s.IsDeleted &&
                s.SubstituteDate == form.SubstituteDate.Date &&
                s.ClassName == form.ClassName &&
                s.LessonNumber == form.LessonNumber &&
                (!editingSubstituteId.HasValue ||
                 s.Id != editingSubstituteId.Value));

            if (duplicateExists)
            {
                errorMessage =
                    "Zastępstwo dla tej klasy, daty i numeru lekcji już istnieje.";
                return;
            }

            // Nauczyciel nie może mieć w tym samym czasie zastępstwa z inną klasą.
            // Konflikt = ten sam dzień, ten sam nauczyciel zastępujący,
            // godziny nakładają się na siebie (albo ten sam numer lekcji).
            var teacherBusy = await db.Substitutes.AnyAsync(s =>
                !s.IsDeleted &&
                s.SubstituteDate == form.SubstituteDate.Date &&
                s.TeacherId == form.TeacherId &&
                (!editingSubstituteId.HasValue ||
                 s.Id != editingSubstituteId.Value) &&
                (s.LessonNumber == form.LessonNumber ||
                 (s.StartTime < end && s.EndTime > start)));

            if (teacherBusy)
            {
                errorMessage =
                    "Ten nauczyciel ma już zastępstwo w tym czasie z inną klasą.";
                return;
            }

            Substitute? item;

            if (editingSubstituteId.HasValue)
            {
                item = await db.Substitutes.FirstOrDefaultAsync(
                    s => s.Id == editingSubstituteId.Value && !s.IsDeleted);

                if (item is null)
                {
                    errorMessage = "Nie znaleziono zastępstwa do edycji.";
                    return;
                }
            }
            else
            {
                item = new Substitute
                {
                    Reason = "Zastępstwo",
                    CreatedAt = DateTime.Now
                };

                db.Substitutes.Add(item);
            }

            item.SubstituteDate = form.SubstituteDate.Date;
            item.ClassName = form.ClassName;
            item.LessonNumber = form.LessonNumber;
            item.StartTime = start;
            item.EndTime = end;
            item.TeacherId = form.TeacherId;
            item.OriginalTeacherId = form.OriginalTeacherId.Value;
            item.RoomId = form.RoomId;
            item.Notes = string.IsNullOrWhiteSpace(form.Notes)
                ? null
                : form.Notes.Trim();

            await db.SaveChangesAsync();
            await LoadDataAsync();

            successMessage = editingSubstituteId.HasValue
                ? "Zapisano zmiany w zastępstwie."
                : "Zastępstwo zostało dodane.";

            editingSubstituteId = null;
            form = new SubstituteForm();

            startTime = "08:00";
            endTime = "08:45";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Nie udało się zapisać zastępstwa.");
            errorMessage =
                "Nie udało się zapisać zastępstwa. Sprawdź model i konfigurację bazy danych.";
        }
        finally
        {
            isSaving = false;
        }
    }


