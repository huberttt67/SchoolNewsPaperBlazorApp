@page "/login"
@rendermode InteractiveServer
@using SchoolNewspaperBlazorApp.Interfaces.Service

@inject IAuthService authService

<PageTitle>Logowanie | Gazetka ETI</PageTitle>

<div class="login-page">

    <!-- Lewa strona: marka i opis -->
    <aside class="login-side">
        <div class="login-side__brand">
            <span class="login-side__logo-wrap">
                <img src="logo.png" alt="Logo ETI" class="login-side__logo" />
            </span>

            <div>
                <div class="login-side__name">GAZETKA <span>ETI</span></div>
                <div class="login-side__tagline">Szkolny portal informacyjny</div>
            </div>
        </div>

        <div class="login-side__content">
            <span class="login-side__eyebrow">Panel redakcji</span>

            <h2>Twórz szkolne wiadomości w jednym miejscu.</h2>

            <p>
                Zaloguj się, aby dodawać artykuły, zarządzać treściami
                i dbać o to, żeby cała szkoła była na bieżąco.
            </p>

            <ul class="login-features">
                <li class="login-feature">
                    <span class="login-feature__icon" aria-hidden="true">📰</span>
                    <div>
                        <strong>Artykuły</strong>
                        <span>Dodawaj i edytuj aktualności ze zdjęciami.</span>
                    </div>
                </li>
                <li class="login-feature">
                    <span class="login-feature__icon" aria-hidden="true">👥</span>
                    <div>
                        <strong>Użytkownicy</strong>
                        <span>Zarządzaj dostępem członków redakcji.</span>
                    </div>
                </li>
                <li class="login-feature">
                    <span class="login-feature__icon" aria-hidden="true">📢</span>
                    <div>
                        <strong>Ogłoszenia</strong>
                        <span>Informuj uczniów o ważnych wydarzeniach.</span>
                    </div>
                </li>
            </ul>
        </div>

        <div class="login-side__footer">
            © @DateTime.Now.Year Gazetka ETI
        </div>
    </aside>

    <!-- Prawa strona: formularz -->
    <main class="login-panel">
        <a href="/" class="login-back">
            <span aria-hidden="true">←</span> Wróć na stronę główną
        </a>

        <div class="login-card">
            <div class="login-heading">
                <h1>Witaj ponownie!</h1>
                <p>Zaloguj się, aby przejść do panelu.</p>
            </div>

            <form @onsubmit="HandleLoginAsync" @onsubmit:preventDefault>
                <div class="login-field">
                    <label for="login-email">Email</label>

                    <div class="login-input-wrapper">
                        <span class="login-field-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none">
                                <rect x="3" y="5" width="18" height="14" rx="3"
                                      stroke="currentColor" stroke-width="1.7" />
                                <path d="m4 7 8 6 8-6"
                                      stroke="currentColor" stroke-width="1.7"
                                      stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </span>

                        <input id="login-email"
                               type="email"
                               @bind="Login"
                               @bind:event="oninput"
                               class="login-input"
                               placeholder="np. uczen@szkola.pl"
                               autocomplete="username"
                               required />
                    </div>
                </div>

                <div class="login-field">
                    <label for="login-password">Hasło</label>

                    <div class="login-input-wrapper">
                        <span class="login-field-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none">
                                <rect x="4" y="10" width="16" height="11" rx="3"
                                      stroke="currentColor" stroke-width="1.7" />
                                <path d="M8 10V7a4 4 0 0 1 8 0v3"
                                      stroke="currentColor" stroke-width="1.7"
                                      stroke-linecap="round" />
                                <circle cx="12" cy="15" r="1.3" fill="currentColor" />
                            </svg>
                        </span>

                        <input id="login-password"
                               type="password"
                               @bind="Password"
                               @bind:event="oninput"
                               class="login-input"
                               placeholder="Wpisz swoje hasło"
                               autocomplete="current-password"
                               required />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="login-error" role="alert">@errorMessage</div>
                }

                <button type="submit" class="login-button" disabled="@isBusy">
                    @(isBusy ? "Logowanie…" : "Zaloguj się")
                    <span aria-hidden="true">→</span>
                </button>
            </form>

            <div class="login-footer">
                <span class="login-footer-line"></span>
                <p>Problem z logowaniem? Skontaktuj się z opiekunem gazetki.</p>
            </div>
        </div>
    </main>
</div>

@code {
    public string Login { get; set; } = string.Empty;
    public string Password { get; set; } = string.Empty;

    private bool isBusy;
    private string? errorMessage;

    private async Task HandleLoginAsync()
    {
        if (isBusy) return;

        if (string.IsNullOrWhiteSpace(Login) || string.IsNullOrWhiteSpace(Password))
        {
            errorMessage = "Wpisz email i hasło.";
            return;
        }

        isBusy = true;
        errorMessage = null;

        try
        {
            // TODO: wywołaj metodę z IAuthService, np.:
            // var ok = await authService.LoginAsync(Login, Password);
            // if (!ok) { errorMessage = "Nieprawidłowy email lub hasło."; return; }
            // Navigation.NavigateTo("/adminPanel");
            await Task.CompletedTask;
        }
        catch
        {
            errorMessage = "Nie udało się zalogować. Spróbuj ponownie.";
        }
        finally
        {
            isBusy = false;
        }
    }
}
