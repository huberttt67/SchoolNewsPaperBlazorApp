    }

    private async Task SaveUserProfileAsync()
    {
        if (editedUser is null || isSavingProfile ||
            !hasAdminAccess || !Can(EnumPermission.ManageUsers))
        {
            return;
        }

        errorMessage = null;
        successMessage = null;
        isSavingProfile = true;

        try
        {
            var id = editedUser.Id;

            await authService.UpdateUserProfileAsync(
                id,
                editLogin,
                editEmail,
                editFirstName,
                editLastName);

            // Ponowny odczyt z bazy, żeby lista pokazywała zapisane dane.
            managedUsers = await authService.GetUsersAsync();
            editedUser = managedUsers.FirstOrDefault(u => u.Id == id);

            if (editedUser is not null)
            {
                editLogin = editedUser.Login;
                editEmail = editedUser.Email;
                editFirstName = editedUser.FirstName;
                editLastName = editedUser.LastName;
            }

            successMessage = "Dane użytkownika zostały zapisane.";
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Błąd zapisu danych użytkownika: {ex}");
            errorMessage = "Nie udało się zapisać danych użytkownika.";
        }
        finally
        {
            isSavingProfile = false;
        }
    }

    private async Task DeleteSelectedUserAsync()
    {
        if (!hasAdminAccess || !IsSuperAdmin ||
            selectedPermissionUserId <= 0 || isDeletingUser)
        {
            return;
        }

        if (selectedPermissionUserId == currentUserId)
        {
            errorMessage = "Nie możesz usunąć własnego konta.";
            return;
        }

        var user = permissionUsers
            .FirstOrDefault(u => u.Id == selectedPermissionUserId);

        if (user is null)
        {
            return;
        }

        bool confirmed;

        try
        {
            confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                $"Czy na pewno chcesz usunąć użytkownika „{user.Login}” ({user.Email})? Konto zostanie wyłączone i nie będzie mogło się zalogować.");
        }
        catch (Exception)
        {
            errorMessage =
                "Nie udało się wyświetlić potwierdzenia usunięcia.";
            return;
        }

        if (!confirmed)
        {
            return;
        }

        errorMessage = null;
        successMessage = null;
        isDeletingUser = true;

        try
        {
            await permissionService.DeleteUserAsync(user.Id);

            permissionUsers =
                await permissionService.GetAllUsersAsync();

            if (permissionUsers.Count == 0)
            {
                selectedPermissionUserId = 0;
                selectedPermissions.Clear();
            }
            else
            {
                selectedPermissionUserId = permissionUsers[0].Id;
                await LoadSelectedUserPermissionsAsync();
            }

            successMessage = "Użytkownik został usunięty.";
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = "Nie udało się usunąć użytkownika.";
        }
        finally
        {
            isDeletingUser = false;
        }
    }

    private async Task LoadSelectedUserPermissionsAsync()
    {
        if (!hasAdminAccess || !IsSuperAdmin || selectedPermissionUserId <= 0)
        {
            selectedPermissions.Clear();
            return;
        }

        try
        {
            var permissions =
                await permissionService.GetUserPermissionsAsync(
                    selectedPermissionUserId);

            selectedPermissions = permissions.ToHashSet();
            savingPermissions.Clear();
            permissionsRenderVersion++;
            errorMessage = null;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Błąd pobierania uprawnień użytkownika: {ex}");

            selectedPermissions.Clear();
            errorMessage =
                "Nie udało się pobrać uprawnień wybranego użytkownika.";
        }
    }

    // Zaznaczenie checkboxa => INSERT do bazy, odznaczenie => DELETE z bazy.
    private async Task TogglePermissionAsync(
        EnumPermission permission,
        ChangeEventArgs args)
    {
        if (!hasAdminAccess || !IsSuperAdmin || selectedPermissionUserId <= 0)
        {
            return;
        }

        if (savingPermissions.Contains(permission))
        {
            return;
        }

        if (PermissionsLocked)
        {
            errorMessage =
                "Uprawnień własnego konta ani konta Master nie można zmieniać.";
            permissionsRenderVersion++;
            return;
        }

        var isChecked = args.Value is bool value && value;

        errorMessage = null;
        successMessage = null;

        if (!isChecked &&
            selectedPermissionUserId == currentUserId &&
            permission == EnumPermission.Master)
        {
            errorMessage =
                "Nie możesz odebrać sobie tego uprawnienia, bo straciłbyś możliwość zarządzania dostępem.";
            permissionsRenderVersion++;
            return;
        }

        savingPermissions.Add(permission);

        try
        {
            if (isChecked)
            {
                await permissionService.AddUserPermissionAsync(
                    selectedPermissionUserId, permission);
            }
            else
            {
                await permissionService.RemoveUserPermissionAsync(
                    selectedPermissionUserId, permission);
            }

            selectedPermissions =
                (await permissionService.GetUserPermissionsAsync(
                    selectedPermissionUserId)).ToHashSet();

            successMessage = isChecked
                ? $"Dodano uprawnienie: {GetPermissionTitle(permission)}."
                : $"Odebrano uprawnienie: {GetPermissionTitle(permission)}.";
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
            permissionsRenderVersion++;
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
            permissionsRenderVersion++;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Błąd zmiany uprawnienia: {ex}");

            errorMessage = "Nie udało się zapisać zmiany uprawnienia.";
            permissionsRenderVersion++;
        }
        finally
        {
            savingPermissions.Remove(permission);
        }
    }

    private List<Permission> GetPermissionsForCategory(
        params EnumPermission[] permissions)
    {
        return availablePermissions
            .Where(p => permissions.Contains(p.Name))
            .OrderBy(p => Array.IndexOf(permissions, p.Name))
            .ToList();
    }

    private static string GetPermissionTitle(EnumPermission permission)
    {
        return permission switch
        {
            EnumPermission.AccessAdminPanel => "Dostęp do panelu administracyjnego",
            EnumPermission.Master => "Administrator główny",
            EnumPermission.CreateArticles => "Dodawanie artykułów",
            EnumPermission.EditArticles => "Edytowanie artykułów",
            EnumPermission.DeleteArticles => "Usuwanie artykułów",
            EnumPermission.ViewUsers => "Wyświetlanie użytkowników",
            EnumPermission.ManageUsers => "Zarządzanie użytkownikami",
            EnumPermission.CreateAnnouncements => "Dodawanie ogłoszeń",
            EnumPermission.EditAnnouncements => "Edytowanie ogłoszeń",
            EnumPermission.DeleteAnnouncements => "Usuwanie ogłoszeń",
            EnumPermission.None => "Brak uprawnień",
            _ => permission.ToString()
        };
    }

    private async Task HandleArticleSavedAsync()
    {
        if (!hasAdminAccess ||
            (!Can(EnumPermission.CreateArticles) &&
             !Can(EnumPermission.EditArticles)))
        {
            return;
        }

        selectedArticle = null;
        await LoadArticleAsync();

        if (view == 1 && string.IsNullOrWhiteSpace(errorMessage))
        {
            successMessage = "Artykuł został zapisany.";
        }
    }

    private async Task RemoveArticleAsync(Article article)
    {
        if (!hasAdminAccess || !Can(EnumPermission.DeleteArticles) || isDeleting)
        {
            return;
        }

        bool confirmed;

        try
        {
            confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                $"Czy na pewno chcesz usunąć artykuł „{article.Title}”?");
        }
        catch (Exception)
        {
            errorMessage =
                "Nie udało się wyświetlić potwierdzenia usunięcia.";
            return;
        }

        if (!confirmed)
        {
            return;
        }

        errorMessage = null;
        successMessage = null;
        isDeleting = true;

        try
        {
            await articleService.RemoveArticleByIdAsync(article.Id);
            articleList = await articleService.GetAllArticlesAsync();

            successMessage = "Artykuł został usunięty.";
        }
        catch (UnauthorizedAccessException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = "Nie udało się usunąć artykułu.";
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void BackToMenu()
    {
        if (!hasAdminAccess)
        {
            return;
        }

        errorMessage = null;
        successMessage = null;
        selectedArticle = null;
        editedUser = null;

        ownCurrentPassword = string.Empty;
        ownNewPassword = string.Empty;
        ownConfirmPassword = string.Empty;

        view = 0;
    }

    private Task LogoutAsync()
    {
        Navigation.NavigateTo("/auth/logout", forceLoad: true);
        return Task.CompletedTask;
    }

    private static string GetArticlePreview(string? articleText)
    {
        if (string.IsNullOrWhiteSpace(articleText))
        {
            return "Brak treści artykułu.";
        }

        return articleText.Length > 180
            ? articleText[..180] + "..."
            : articleText;
    }
}
